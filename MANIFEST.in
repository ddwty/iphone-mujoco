include LICENSE README.md README.zh-CN.md THIRD_PARTY_NOTICES.md
include .github/CONTRIBUTING.md .github/SECURITY.md
include .gitignore .gitattributes .editorconfig
include *.command
recursive-include docs *.md *.svg *.png *.jpg *.webp
recursive-include examples *.py *.json *.xml
recursive-include tools *.py
recursive-include tests *.py *.json *.xml
recursive-include src/iphone_mujoco/assets *.xml *.json
prune validation
prune recordings
prune profiles
prune scenes
prune .venv
prune .cache
prune dist
prune build
exclude AGENTS.md VALIDATION.md MUJOCO_LOG.TXT .DS_Store
global-exclude __pycache__ *.py[cod] .DS_Store
