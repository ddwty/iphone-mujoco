include LICENSE README.md README.zh-CN.md README.en.md
include CONTRIBUTING.md CHANGELOG.md SECURITY.md THIRD_PARTY_NOTICES.md CITATION.cff
include .gitignore .gitattributes .editorconfig
include *.command run_iphone.py
recursive-include docs *.md *.svg *.png *.jpg *.webp
recursive-include examples *.py *.json *.xml
recursive-include tools *.py
recursive-include tests *.py *.json *.xml
recursive-include src/iphone_mujoco/assets *.xml *.json
prune validation
prune recordings
prune profiles
prune scenes
prune .venv
prune .cache
prune dist
prune build
exclude VALIDATION.md MUJOCO_LOG.TXT .DS_Store
global-exclude __pycache__ *.py[cod] .DS_Store
