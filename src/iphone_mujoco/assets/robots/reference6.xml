<mujoco model="asmagic_reference6">
  <!--Original teaching model. Illustrative geometry and dynamics, not UR/Panda or a physical robot digital twin. Lengths in metres; angles in radians. Gravity-compensated links.-->
  <compiler angle="radian" autolimits="true" />
  <option timestep=".002" integrator="implicitfast" />
  <default>
    <joint damping="2" armature=".05" range="-2.9 2.9" />
    <geom density="500" friction=".8 .01 .001" rgba=".23 .46 .65 1" />
    <position kp="400" kv="40" ctrlrange="-2.9 2.9" forcerange="-70 70" />
  </default>
  <worldbody>
    <body name="base">
      <geom type="cylinder" size=".09 .04" pos="0 0 .04" rgba=".18 .20 .23 1" />
      <body name="link1" pos="0 0 .08" gravcomp="1">
        <joint name="joint1" axis="0 0 1" />
        <geom name="link1_geom" type="capsule" fromto="0 0 0 0 0 0.18" size=".032" rgba=".23 .46 .65 1" />
        <geom type="sphere" size=".035" rgba=".18 .20 .23 1" />
        <body name="link2" pos="0 0 0.18" gravcomp="1">
          <joint name="joint2" axis="0 1 0" />
          <geom name="link2_geom" type="capsule" fromto="0 0 0 0.24 0 0" size=".032" rgba=".23 .46 .65 1" />
          <geom type="sphere" size=".035" rgba=".18 .20 .23 1" />
          <body name="link3" pos="0.24 0 0" gravcomp="1">
            <joint name="joint3" axis="0 1 0" />
            <geom name="link3_geom" type="capsule" fromto="0 0 0 0.22 0 0" size=".032" rgba=".23 .46 .65 1" />
            <geom type="sphere" size=".035" rgba=".18 .20 .23 1" />
            <body name="link4" pos="0.22 0 0" gravcomp="1">
              <joint name="joint4" axis="1 0 0" />
              <geom name="link4_geom" type="capsule" fromto="0 0 0 0.08 0 0" size=".023" rgba=".23 .46 .65 1" />
              <geom type="sphere" size=".035" rgba=".18 .20 .23 1" />
              <body name="link5" pos="0.08 0 0" gravcomp="1">
                <joint name="joint5" axis="0 1 0" />
                <geom name="link5_geom" type="capsule" fromto="0 0 0 0.07 0 0" size=".023" rgba=".23 .46 .65 1" />
                <geom type="sphere" size=".035" rgba=".18 .20 .23 1" />
                <body name="link6" pos="0.07 0 0" gravcomp="1">
                  <joint name="joint6" axis="1 0 0" />
                  <geom name="link6_geom" type="capsule" fromto="0 0 0 0.06 0 0" size=".023" rgba=".23 .46 .65 1" />
                  <geom type="sphere" size=".035" rgba=".18 .20 .23 1" />
                  <body name="tool" pos="0.06 0 0" gravcomp="1">
                    <geom type="box" size=".025 .035 .025" pos=".025 0 0" rgba=".22 .24 .26 1" />
                    <site name="tcp" pos=".13 0 0" size=".008" rgba="0 .9 .4 1" />
                    <body name="finger_left" pos=".05 0.01 0" gravcomp="1">
                      <joint name="finger_left_joint" type="slide" axis="0 1 0" range="0 .04" damping="1" />
                      <geom type="box" size=".045 .008 .015" pos=".045 0 0" mass=".03" rgba=".12 .13 .14 1" />
                    </body>
                    <body name="finger_right" pos=".05 -0.01 0" gravcomp="1">
                      <joint name="finger_right_joint" type="slide" axis="0 -1 0" range="0 .04" damping="1" />
                      <geom type="box" size=".045 .008 .015" pos=".045 0 0" mass=".03" rgba=".12 .13 .14 1" />
                    </body>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>
  <actuator>
    <position name="servo1" joint="joint1" />
    <position name="servo2" joint="joint2" />
    <position name="servo3" joint="joint3" />
    <position name="servo4" joint="joint4" />
    <position name="servo5" joint="joint5" />
    <position name="servo6" joint="joint6" />
    <position name="finger_left_servo" joint="finger_left_joint" kp="120" kv="8" ctrlrange="0 .04" forcerange="-10 10" />
    <position name="finger_right_servo" joint="finger_right_joint" kp="120" kv="8" ctrlrange="0 .04" forcerange="-10 10" />
  </actuator>
  <keyframe>
    <key name="home" qpos="0 -0.65 1.25 0 -0.6 0 0.04 0.04" ctrl="0 -0.65 1.25 0 -0.6 0 0.04 0.04" />
  </keyframe>
</mujoco>
