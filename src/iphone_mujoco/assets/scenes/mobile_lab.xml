<mujoco model="Mobile perception laboratory">
  <option timestep="0.002" integrator="implicitfast"/>
  <visual>
    <global offwidth="1280" offheight="960"/>
    <quality shadowsize="4096"/>
    <headlight ambient=".2 .2 .2" diffuse=".45 .45 .45" specular=".15 .15 .15"/>
    <map znear=".005" zfar="16"/>
  </visual>
  <asset>
    <texture name="lab_sky" type="skybox" builtin="gradient" rgb1=".65 .70 .74" rgb2=".87 .89 .91" width="512" height="3072"/>
    <material name="lab_floor" rgba=".34 .37 .40 1" specular=".15" shininess=".15"/>
    <material name="lab_wall" rgba=".76 .78 .80 1" specular=".05"/>
    <material name="lab_steel" rgba=".30 .34 .38 1" specular=".7" shininess=".5"/>
    <material name="lab_aluminium" rgba=".64 .68 .72 1" specular=".8" shininess=".6"/>
    <material name="lab_bin" rgba=".18 .25 .30 1" specular=".2"/>
    <material name="lab_panel" rgba=".86 .87 .87 1" specular=".15"/>
  </asset>
  <worldbody>
    <light name="lab_key" pos="0 -2 4.5" dir=".25 .3 -1" diffuse=".75 .75 .75" specular=".4 .4 .4"/>
    <light name="lab_fill" pos="3 2 3.8" dir="-.2 -.2 -1" diffuse=".45 .45 .45" castshadow="false"/>
